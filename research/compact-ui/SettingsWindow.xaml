<Window x:Class="Switcheroonie.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Switcheroonie · Settings" Width="520" Height="610" MinWidth="460" MinHeight="460"
        Background="#17181B" Foreground="{StaticResource Text}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="Window_Loaded" Deactivated="Window_Deactivated" Closing="Window_Closing"
        StateChanged="Settings_StateChanged" DpiChanged="Settings_DpiChanged" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" PreviewGotKeyboardFocus="Window_PreviewGotKeyboardFocus">
  <Grid Margin="20" TextElement.Foreground="{StaticResource Text}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Settings" FontSize="25" FontWeight="SemiBold"/></StackPanel>
      <Button Grid.Column="1" Content="Done" Click="HidePanel_Click" Padding="18,8" VerticalAlignment="Center"/>
    </Grid>
    <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0" ScrollChanged="Settings_ScrollChanged">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16">
          <StackPanel>
            <TextBlock Text="Switching &amp; startup" FontSize="16" FontWeight="SemiBold"/>
            <CheckBox x:Name="AutomaticCheck" Content="Follow headset use automatically" IsEnabled="False" Margin="0,13,0,10"/>
            <Button x:Name="ApplyAutomaticButton" Content="Apply / resume automatic" Click="AutomaticApply_Click" IsEnabled="False" HorizontalAlignment="Left" Padding="12,7"/>
            <TextBlock x:Name="ManualModeText" Text="Reading your selection…" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
            <Separator Margin="0,12" Background="{StaticResource Line}"/>
            <CheckBox x:Name="StartWithWindowsCheck" Content="Start with Windows" IsEnabled="False" Margin="0,0,0,10"/>
            <Button x:Name="ApplyStartupButton" Content="Apply startup setting" Click="StartupApply_Click" IsEnabled="False" Padding="12,7" HorizontalAlignment="Left"/>
            <TextBlock x:Name="StartupRegistrationText" Text="Startup setting has not been read." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16">
          <StackPanel>
            <TextBlock Text="Desktop controls" FontSize="16" FontWeight="SemiBold"/>
            <CheckBox x:Name="GameInputCheck" Content="Mouse and keyboard in VRChat" IsEnabled="False" Margin="0,13,0,0"/>
            <TextBlock Text="Click VRChat to play. Esc: menu. C / Z: toggle crouch / prone. M: menu hand. Hold right mouse for a pointer." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,14"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="Mouse sensitivity"/><TextBlock x:Name="SensitivityText" Grid.Column="1" Text="1.00×" HorizontalAlignment="Right"/></Grid>
            <Slider x:Name="SensitivitySlider" Minimum="0.1" Maximum="5" Value="1" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Sensitivity_Changed" Margin="0,9,0,12" AutomationProperties.Name="Mouse sensitivity multiplier"/>
            <Button x:Name="ApplyGameInputButton" Content="Apply controls" Click="GameInputApply_Click" IsEnabled="False" Padding="12,7" HorizontalAlignment="Left"/>
            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Height offset" VerticalAlignment="Center"/><TextBlock x:Name="HeightText" Grid.Column="1" Text="0.00 m" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <Button x:Name="ResetHeightButton" Grid.Column="2" Content="Reset" Click="HeightReset_Click" IsEnabled="False" Padding="12,6"/>
            </Grid>
            <Slider x:Name="HeightSlider" Minimum="-1.5" Maximum="1.5" Value="0" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Height_Changed" IsEnabled="False" Margin="0,9,0,0" AutomationProperties.Name="Desktop height offset in meters"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16">
          <Expander x:Name="AdvancedPadExpander" Header="Optional panel controls" Collapsed="AdvancedPad_Collapsed">
            <StackPanel Margin="0,12,0,0">
              <TextBlock x:Name="PadStatusText" Text="Released · optional fallback" Foreground="{StaticResource Muted}" FontSize="12"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,10"><RadioButton x:Name="HeadRadio" Content="Head look" IsChecked="True" Checked="ControlMode_Changed" Margin="0,0,22,0"/><RadioButton x:Name="HandRadio" Content="Hand aim" Checked="ControlMode_Changed"/></StackPanel>
              <Border x:Name="InteractionPad" Background="#141518" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="0" Height="140" Focusable="True" IsEnabled="False" MouseDown="Pad_MouseDown" MouseUp="Pad_MouseUp" MouseMove="Pad_MouseMove" LostMouseCapture="Pad_LostMouseCapture" AutomationProperties.Name="Optional desktop interaction pad">
                <StackPanel IsHitTestVisible="False" VerticalAlignment="Center" Margin="16"><TextBlock x:Name="PadTitleText" Text="CLICK TO ARM" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Accent}"/><TextBlock x:Name="PadInstructionText" Text="Right-drag to look" FontSize="12" Margin="0,9,0,0"/></StackPanel>
              </Border>
              <WrapPanel Margin="0,12,0,0"><Button x:Name="NeutralButton" Content="Rest hands" Click="Neutral_Click" Padding="10,7" Margin="0,0,8,8"/><Button x:Name="ExtendedButton" Content="Extended" Visibility="Collapsed" Click="Extended_Click" Padding="10,7" Margin="0,0,8,8"/><Button x:Name="MenuPoseButton" Content="Pointer" Click="MenuPose_Click" Padding="10,7" Margin="0,0,8,8"/><Button x:Name="MenuButton" Content="Toggle menu" Click="Menu_Click" Focusable="False" Padding="10,7" Margin="0,0,0,8"/></WrapPanel>
            </StackPanel>
          </Expander>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16">
          <Expander Header="Optional OSC input">
            <StackPanel Margin="0,12,0,0"><CheckBox x:Name="OscCheck" Content="Send VRChat OSC input" IsEnabled="False"/><TextBlock Text="Enable OSC in VRChat to receive it." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="75"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="OscHost" Text="127.0.0.1" Margin="0,0,8,0" AutomationProperties.Name="OSC loopback address"/><TextBox x:Name="OscPort" Grid.Column="1" Text="9000" Margin="0,0,8,0" AutomationProperties.Name="OSC port"/><Button x:Name="ApplyOscButton" Grid.Column="2" Content="Apply" Click="OscApply_Click" IsEnabled="False" Padding="12,7"/></Grid>
              <TextBlock x:Name="OscStatusText" Text="OSC input is disabled." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/>
            </StackPanel>
          </Expander>
        </Border>
        <Border Style="{StaticResource Card}" Padding="16">
          <Expander x:Name="HelpExpander" Header="Help &amp; diagnostics">
            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="Click VRChat to play. WASD moves, Shift runs, Space jumps." FontSize="12"/>
              <TextBlock Text="C / Z toggle crouch / prone. M raises the left menu hand; M or Esc closes it. Esc opens or closes the menu. Tab is unchanged." FontSize="12" Margin="0,9,0,0"/>
              <TextBlock Text="Y opens chat; Enter sends, Esc cancels. Hold right mouse for pointer control." FontSize="12" Margin="0,9,0,0"/>
              <TextBlock Text="Ctrl + Alt + F10 switches mode. Ctrl + Alt + F12 releases inputs; click the game to resume. Alt-tab releases held controls." FontSize="12" Margin="0,9,0,0"/>
              <TextBlock x:Name="HotkeyText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
              <TextBlock Text="X hides the panel to the tray. Launch it again to reopen." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
              <Separator Margin="0,14" Background="{StaticResource Line}"/>
              <TextBlock Text="Updates" FontWeight="SemiBold"/>
              <TextBlock x:Name="UpdateText" Text="Not checked yet" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
              <Button x:Name="CheckUpdateButton" Content="Check for updates" Click="CheckUpdate_Click" HorizontalAlignment="Left" Padding="12,7" Margin="0,9,0,0"/>
              <Expander x:Name="TechnicalExpander" Header="Technical status" Margin="0,14,0,0">
                <StackPanel Margin="0,10,0,0">
              <TextBlock x:Name="ServiceStateText" Text="Connecting service…" FontWeight="SemiBold"/><TextBlock x:Name="ServiceDetailText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/>
              <TextBlock x:Name="StartupNextText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
              <TextBlock Text="Headset-free startup" FontWeight="SemiBold" Margin="0,15,0,0"/><TextBlock x:Name="ColdStartText" FontSize="12" Margin="0,7,0,0"/>
              <TextBlock Text="The current backend needs an existing vendor VR display connection. A non-VR VRChat session cannot acquire VR here. Headset-free continuity remains unverified." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/>
              <TextBlock x:Name="EvidenceText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
              <TextBlock x:Name="DiagnosticText" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,16,0,0"/>
              <WrapPanel Margin="0,13,0,0"><Button Content="Save report" Click="SaveReport_Click" Padding="12,7" Margin="0,0,8,8"/><Button Content="Retry service" Click="RetryService_Click" Padding="12,7" Margin="0,0,0,8"/></WrapPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </Expander>
        </Border>
        <Border x:Name="CreditsCard" Style="{StaticResource Card}" Padding="16">
          <Expander x:Name="CreditsExpander" Header="Credits">
            <StackPanel Margin="0,12,0,0">
              <TextBlock Text="The entire app was vibe coded with GPT-6.1 Sol." FontSize="13"/>
              <TextBlock Text="Built with bingbongs and Codex · OpenAI" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
              <TextBlock Text=".NET + WPF · Microsoft&#x0a;OpenVR / SteamVR · Valve&#x0a;MinHook · Tsuda Kageyu&#x0a;Mascot artwork · supplied by the user" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
              <TextBlock Text="Third-party licenses are included with the app." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"/>
            </StackPanel>
          </Expander>
        </Border>
        <Border x:Name="SpinCard" Style="{StaticResource Card}" Padding="16">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
            <StackPanel>
              <CheckBox x:Name="SpinCheck" Content="speeeeeeen" IsEnabled="False" Click="Spin_Click" FontWeight="SemiBold"/>
              <TextBlock x:Name="SpinStatusText" Text="Off" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,7,0,0"/>
              <TextBlock Text="Numpad 5: start / stop&#x0a;4 / 6: roll sideways · 8 / 2: flip forward / back" FontSize="12" Margin="0,10,0,0"/>
              <TextBlock Text="Rotating your body can cause motion sickness. Stop if uncomfortable." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/>
            </StackPanel>
            <Grid x:Name="SpinIconHost" Grid.Column="1" VerticalAlignment="Top" Margin="10,0,0,0"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="MessageText" Text="Connecting local service…" Foreground="{StaticResource Muted}" FontSize="11" MaxHeight="46" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" VerticalAlignment="Center"/><Button x:Name="ReleaseButton" Grid.Column="1" Content="Release inputs" Click="Release_Click" Padding="12,8" AutomationProperties.Name="Emergency release all inputs"/></Grid>
    <StackPanel Visibility="Collapsed"><Button x:Name="PhysicalButton"/><Button x:Name="DesktopButton"/><TextBlock x:Name="ModeText"/><TextBlock x:Name="StateText"/><TextBlock x:Name="DetailText"/><TextBlock x:Name="RuntimeText"/><TextBlock x:Name="TrackingText"/><TextBlock x:Name="DisplayText"/><TextBlock x:Name="InputText"/><TextBlock x:Name="GameCaptureText"/><TextBlock x:Name="GameGuideText"/><TextBlock x:Name="GameMenuGuideText"/></StackPanel>
  </Grid>
</Window>
